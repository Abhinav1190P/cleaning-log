{
  "name": "cleaning-log-api",
  "version": "1.0.0",
  "description": "Equipment cleaning log API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:local": "dotenv -e .env -- node dist/src/index.js",
    "db:migrate": "dotenv -e .env -- tsx scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "pretest": "dotenv -e .env.test -- tsx scripts/migrate.ts",
    "test": "dotenv -e .env.test -- jest --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
